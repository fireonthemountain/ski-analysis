# Database
DATABASE_URL=postgresql://skiuser:skipass123@localhost:5432/ski_analysis

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=ski-videos
MINIO_USE_SSL=false

# AWS S3 (if using AWS instead of MinIO)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=ski-analysis-videos

# API Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Video Processing
MAX_VIDEO_SIZE_MB=500
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv
VIDEO_PROCESSING_FPS=30

# ML Models
POSE_MODEL=mediapipe  # or 'openpose'
POSE_CONFIDENCE_THRESHOLD=0.5

# Application
DEBUG=true
LOG_LEVEL=INFO
