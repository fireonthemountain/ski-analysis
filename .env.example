# Copy to .env (git-ignored) and change the secrets:   cp .env.example .env
#
# The plain local run (scripts/run_dev.sh) needs NONE of this: it uses SQLite and
# local files under backend/data. These values matter for `docker compose up`,
# or when you point the API at PostgreSQL / MinIO yourself.

# --- Secrets (docker compose refuses to start without these) -----------------
POSTGRES_PASSWORD=change-me-postgres
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-secret
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Database ---------------------------------------------------------------
POSTGRES_DB=ski_analysis
POSTGRES_USER=skiuser
# Leave unset for SQLite at backend/data/ski.db. For a local PostgreSQL:
# DATABASE_URL=postgresql://skiuser:change-me-postgres@localhost:5432/ski_analysis

# --- Storage for legacy single-photo uploads: local | minio | s3 --------------
# STORAGE_TYPE=local
# MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_NAME=ski-videos
# MINIO_USE_SSL=false

# --- API / UI ports (unique per project; do not reuse 8000/5173/5000) ---------
API_PORT=8003
FRONTEND_PORT=5177
# Extra browser origins allowed to call the API (private-LAN addresses are always allowed)
CORS_ORIGINS=http://localhost:5177

# --- Analysis ---------------------------------------------------------------
# POSE_MODEL=heavy            # heavy (most accurate) | full | lite
# ANALYSIS_FPS=15             # frames per second sampled from video
# MAX_ANALYSIS_SECONDS=90     # only the first N seconds of a clip are analysed
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=25
